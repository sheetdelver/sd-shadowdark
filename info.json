{
    "id": "shadowdark",
    "version": "0.9.3",
    "title": "Shadowdark RPG",
    "manifest": {
        "ui": "module/ui.tsx",
        "logic": "src/server/ShadowdarkAdapter.ts",
        "server": "module/server"
    },
    "compatibility": {
        "coreVersion": ">=0.18.0",
        "apiContracts": {
            "module-api": ">=1.3.0 <2.0.0",
            "ui-extension-api": ">=3.1.0 <4.0.0",
            "roll-engine-api": ">=1.0.0 <2.0.0"
        }
    },
    "combatTracking": {
        "attributes": [
            { "key": "hp", "label": "HP", "path": "system.attributes.hp", "kind": "resource", "showInRoster": true },
            { "key": "ac", "label": "AC", "path": "derived.ac", "kind": "number", "showInRoster": true },
            { "key": "level", "label": "Level", "path": "system.level.value", "kind": "number" },
            { "key": "str", "label": "STR", "path": "system.abilities.str.base", "kind": "number", "actorTypes": ["Player"] },
            { "key": "dex", "label": "DEX", "path": "system.abilities.dex.base", "kind": "number", "actorTypes": ["Player"] },
            { "key": "con", "label": "CON", "path": "system.abilities.con.base", "kind": "number", "actorTypes": ["Player"] },
            { "key": "int", "label": "INT", "path": "system.abilities.int.base", "kind": "number", "actorTypes": ["Player"] },
            { "key": "wis", "label": "WIS", "path": "system.abilities.wis.base", "kind": "number", "actorTypes": ["Player"] },
            { "key": "cha", "label": "CHA", "path": "system.abilities.cha.base", "kind": "number", "actorTypes": ["Player"] }
        ]
    },
    "compendiumPacks": {
        "packs": [
            {
                "id": "shadowdark.ancestries",
                "type": "Item",
                "hydrate": true
            },
            {
                "id": "shadowdark.backgrounds",
                "type": "Item",
                "hydrate": true
            },
            {
                "id": "shadowdark.class-abilities",
                "type": "Item",
                "hydrate": true
            },
            {
                "id": "shadowdark.classes",
                "type": "Item",
                "hydrate": true
            },
            {
                "id": "shadowdark.conditions",
                "type": "Item",
                "hydrate": true
            },
            {
                "id": "shadowdark.gear",
                "type": "Item",
                "hydrate": true
            },
            {
                "id": "shadowdark.languages",
                "type": "Item",
                "hydrate": true
            },
            {
                "id": "shadowdark.magic-items",
                "type": "Item",
                "hydrate": true
            },
            {
                "id": "shadowdark.patrons-and-deities",
                "type": "Item",
                "hydrate": true
            },
            {
                "id": "shadowdark.properties",
                "type": "Item",
                "hydrate": false
            },
            {
                "id": "shadowdark.spell-effects",
                "type": "Item",
                "hydrate": true
            },
            {
                "id": "shadowdark.spells",
                "type": "Item",
                "hydrate": true
            },
            {
                "id": "shadowdark.talents",
                "type": "Item",
                "hydrate": true
            },
            {
                "id": "shadowdark.rollable-tables",
                "type": "RollTable",
                "hydrate": true
            }
        ]
    }
}
